# Public site origin, no trailing slash. Used for canonical URLs when set.
# Leave blank in local development.
VITE_SITE_URL=

# mock — prototype checkout. No card fields. No charge.
# closed — checkout route stays open, payment is paused, the cart is kept.
VITE_PAYMENT_PROVIDER=mock

# mock — signed prototype locators. No file bytes. No public bucket.
VITE_DELIVERY_PROVIDER=mock

# console — print analytics events. Anything else stays silent.
VITE_ANALYTICS_SINK=

# Live payment keys, storage credentials, and mail credentials are not used
# in this prototype. Do not commit them. Put them on the host when a provider
# is connected.
